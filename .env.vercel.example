# Vercel Environment Variables for Trainer Portal

# Backend API URL (required for server-side rewrites)
# All requests to /api/v2/* will be rewritten to this URL
# For staging: https://lobster.element26-staging-2.staging.c66.me/api/v2
# For production: https://your-api-domain.com/api/v2
API_UPSTREAM_URL=https://lobster.element26-staging-2.staging.c66.me

# Stripe Public Key (required for payments)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# Support/Triage Integration (optional)
# Used for automatic issue triage via Supabase functions
NEXT_PUBLIC_TRIAGE_FUNCTION_URL=https://your-triage-function-url.supabase.co/functions/v1/triage

# Supabase Configuration (required for support features)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Asana Integration (required for support tickets)
NEXT_PUBLIC_ASANA_PAT=1/...
NEXT_PUBLIC_ASANA_PROJECT_GID=...

# PostHog Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# Sentry Error Tracking (optional)
NEXT_PUBLIC_SENTRY_AUTH_TOKEN=sntrys_eyJ...
